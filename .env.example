# =====================================================================
# AI DevOps Incident Response Agent Environment Configuration
# =====================================================================

# 1. Groq LLM API Key (Required)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# 2. Qdrant Vector Database Configuration (Optional for Cloud / Remote)
# Leave blank to use local persistent storage at ./qdrant_storage
# QDRANT_URL=https://your-cluster-url.qdrant.tech
# QDRANT_API_KEY=your-qdrant-api-key

# 3. PostgreSQL Database Connection (Optional for Standalone Streamlit mode)
# Required only if using FastAPI + PostgreSQL user auth persistence
# DATABASE_URL=postgresql://postgres:password@localhost:5432/devops_agent

# 4. JWT Authentication Secrets (Used by FastAPI backend)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
