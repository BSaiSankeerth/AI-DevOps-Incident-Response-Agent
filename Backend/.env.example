# PostgreSQL connection string for the database created from schema.sql
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/devops_agent

# Replace with a long, random secret before running the backend
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Groq API key used by the incident investigation agent
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
